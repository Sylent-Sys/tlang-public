static const tlang_route_seg __tl_r1_segs[1] = {
    { TLANG_SEG_STATIC, TLANG_STR_INIT("items") }
};
static const tlang_route __tl_r1 = { TLANG_STR_INIT("GET"), __tl_r1_segs, 1, 0 };

static bool tlj_parse_Item(tlang_fiber* __fib, const char** __p, const char* __end, tl_Item* __out, int __depth) {
    const char* __q = *__p;
    uint64_t __seen = 0;
    if (__depth >= json_max_depth()) return false;
    __q = json_skip_ws(__q, __end);
    if (__q >= __end || *__q != '{') return false;
    __q++;
    __q = json_skip_ws(__q, __end);
    if (__q < __end && *__q == '}') { __q++; goto __done; }
    for (;;) {
        tlang_string __key;
        __q = json_skip_ws(__q, __end);
        if (!json_scan_key(&__q, __end, &__key)) return false;
        __q = json_skip_ws(__q, __end);
        if (__q >= __end || *__q != ':') return false;
        __q++;
        __q = json_skip_ws(__q, __end);
        if (__key.len == 2 && memcmp(__key.data, "id", 2) == 0) {
            if (!json_scan_int64(&__q, __end, &__out->f_id)) return false;
            __seen |= UINT64_C(1) << 0;
        } else if (__key.len == 4 && memcmp(__key.data, "name", 4) == 0) {
            if (!json_scan_string(&__q, __end, __fib->arena, &__out->f_name)) return false;
            __seen |= UINT64_C(1) << 1;
        } else {
            if (!json_skip_value(&__q, __end, __depth)) return false;
        }
        __q = json_skip_ws(__q, __end);
        if (__q >= __end) return false;
        if (*__q == ',') { __q++; continue; }
        if (*__q == '}') { __q++; break; }
        return false;
    }
    __done: ;
    *__p = __q;
    return (__seen & UINT64_C(0x3)) == UINT64_C(0x3);
}

static void tlj_write_Item(tlang_fiber* __fib, tlang_buf* __b, tl_Item* __v) {
    TLANG_BUF_PUT_LIT(__b, "{\"id\":");
    json_write_i64(__b, __v->f_id);
    TLANG_BUF_PUT_LIT(__b, ",\"name\":");
    json_write_str(__b, __v->f_name);
    tlang_buf_putc(__b, '}');
}

static bool tlj_parse_arr_Item(tlang_fiber* __fib, const char** __p, const char* __end, tlang_slice_Item** __out, int __depth) {
    const char* __q = *__p;
    if (__depth >= json_max_depth()) return false;
    __q = json_skip_ws(__q, __end);
    if (__q >= __end || *__q != '[') return false;
    __q++;
    tlang_slice_Item* __s = TLANG_SLICE_NEW(__fib, Item);
    __q = json_skip_ws(__q, __end);
    if (__q < __end && *__q == ']') { __q++; goto __done; }
    for (;;) {
        __q = json_skip_ws(__q, __end);
        tl_Item* __e;
        tl_Item* __o = (tl_Item*)tlang_alloc_zeroed(__fib, sizeof(tl_Item));
        if (!tlj_parse_Item(__fib, &__q, __end, __o, __depth + 1)) return false;
        __e = __o;
        TLANG_SLICE_PUSH(__fib, __s, __e);
        __q = json_skip_ws(__q, __end);
        if (__q >= __end) return false;
        if (*__q == ',') { __q++; continue; }
        if (*__q == ']') { __q++; break; }
        return false;
    }
    __done: ;
    *__out = __s;
    *__p = __q;
    return true;
}

static void tlj_write_arr_Item(tlang_fiber* __fib, tlang_buf* __b, tlang_slice_Item* __v) {
    tlang_buf_putc(__b, '[');
    for (int64_t __i = 0; __i < __v->len; __i++) {
        if (__i > 0) tlang_buf_putc(__b, ',');
        tl_Item* __e = __v->items[__i];
        tlj_write_Item(__fib, __b, __e);
    }
    tlang_buf_putc(__b, ']');
}

static bool tlj_parse_arr_i64(tlang_fiber* __fib, const char** __p, const char* __end, tlang_slice_i64** __out, int __depth) {
    const char* __q = *__p;
    if (__depth >= json_max_depth()) return false;
    __q = json_skip_ws(__q, __end);
    if (__q >= __end || *__q != '[') return false;
