    if (__q < __end && *__q == ']') { __q++; goto __done; }
    for (;;) {
        __q = json_skip_ws(__q, __end);
        int64_t __e;
        if (!json_scan_int64(&__q, __end, &__e)) return false;
        TLANG_SLICE_PUSH(__fib, __s, __e);
        __q = json_skip_ws(__q, __end);
        if (__q >= __end) return false;
        if (*__q == ',') { __q++; continue; }
        if (*__q == ']') { __q++; break; }
        return false;
    }
    __done: ;
    *__out = __s;
    *__p = __q;
    return true;
}

static void tlj_write_arr_i64(tlang_fiber* __fib, tlang_buf* __b, tlang_slice_i64* __v) {
    tlang_buf_putc(__b, '[');
    for (int64_t __i = 0; __i < __v->len; __i++) {
        if (__i > 0) tlang_buf_putc(__b, ',');
        int64_t __e = __v->items[__i];
        json_write_i64(__b, __e);
    }
    tlang_buf_putc(__b, ']');
