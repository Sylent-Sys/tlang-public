static bool tlj_parse_Batch(tlang_fiber* __fib, const char** __p, const char* __end, tl_Batch* __out, int __depth) {
    const char* __q = *__p;
    uint64_t __seen = 0;
    if (__depth >= json_max_depth()) return false;
    __q = json_skip_ws(__q, __end);
    if (__q >= __end || *__q != '{') return false;
    __q++;
    __q = json_skip_ws(__q, __end);
    if (__q < __end && *__q == '}') { __q++; goto __done; }
    for (;;) {
        tlang_string __key;
        __q = json_skip_ws(__q, __end);
        if (!json_scan_key(&__q, __end, &__key)) return false;
        __q = json_skip_ws(__q, __end);
        if (__q >= __end || *__q != ':') return false;
        __q++;
        __q = json_skip_ws(__q, __end);
        if (__key.len == 5 && memcmp(__key.data, "items", 5) == 0) {
            tlang_slice_Item* __a = NULL;
            if (!tlj_parse_arr_Item(__fib, &__q, __end, &__a, __depth + 1)) return false;
            __out->f_items = __a;
            __seen |= UINT64_C(1) << 0;
        } else if (__key.len == 3 && memcmp(__key.data, "ids", 3) == 0) {
            tlang_slice_i64* __a = NULL;
            if (!tlj_parse_arr_i64(__fib, &__q, __end, &__a, __depth + 1)) return false;
            __out->f_ids = __a;
