void tl_f_route_dispatcher(tlang_fiber* __fib, tlang_ctx* l_ctx) {
    tl_Batch* l_b;
    tlang_slice_i64* l_ids;
    tl_Batch* __t1 = (tl_Batch*)tlang_alloc_zeroed(__fib, sizeof(tl_Batch));
    __t1->f_items = TLANG_SLICE_NEW(__fib, Item);
    __t1->f_ids = TLANG_SLICE_NEW(__fib, i64);
    l_b = __t1;
    const char* __jp2 = l_ctx->body.data;
    const char* __je2 = __jp2 + l_ctx->body.len;
    bool __t3 = tlj_parse_Batch(__fib, &__jp2, __je2, l_b, 0) && json_skip_ws(__jp2, __je2) == __je2;
    if (!__t3) {
        tlang_ctx_text(__fib, l_ctx, 400, TLANG_STR("bad"));
        return;
    }
    if (tlang_ctx_match(l_ctx, &__tl_r1)) {
        {
            tlang_buf __b4;
            tlang_buf_init(__fib, &__b4, 256);
            tlj_write_arr_Item(__fib, &__b4, l_b->f_items);
            tlang_ctx_json(__fib, l_ctx, 200, tlang_buf_string(&__b4));
        }
        return;
    }
    tlang_slice_i64* __t5 = TLANG_SLICE_NEW(__fib, i64);
    TLANG_SLICE_RESERVE(__fib, __t5, 2);
    TLANG_SLICE_PUSH(__fib, __t5, 1);
    TLANG_SLICE_PUSH(__fib, __t5, 2);
    l_ids = __t5;
    {
        tlang_buf __b6;
        tlang_buf_init(__fib, &__b6, 256);
        tlj_write_arr_i64(__fib, &__b6, l_ids);
        tlang_ctx_json(__fib, l_ctx, 200, tlang_buf_string(&__b6));
    }
}

static const tlang_program __tl_program = {
