static bool tlj_parse_Address(tlang_fiber* __fib, const char** __p, const char* __end, tl_Address* __out, int __depth) {
    const char* __q = *__p;
    uint64_t __seen = 0;
    if (__depth >= json_max_depth()) return false;
    __q = json_skip_ws(__q, __end);
    if (__q >= __end || *__q != '{') return false;
    __q++;
    __q = json_skip_ws(__q, __end);
    if (__q < __end && *__q == '}') { __q++; goto __done; }
    for (;;) {
        tlang_string __key;
        __q = json_skip_ws(__q, __end);
        if (!json_scan_key(&__q, __end, &__key)) return false;
        __q = json_skip_ws(__q, __end);
        if (__q >= __end || *__q != ':') return false;
        __q++;
        __q = json_skip_ws(__q, __end);
        if (__key.len == 4 && memcmp(__key.data, "city", 4) == 0) {
            if (!json_scan_string(&__q, __end, __fib->arena, &__out->f_city)) return false;
            __seen |= UINT64_C(1) << 0;
        } else if (__key.len == 3 && memcmp(__key.data, "zip", 3) == 0) {
            if (json_scan_null(&__q, __end)) {
                __out->f_zip = TLANG_NONE(i32);
            } else {
                if (!json_scan_int32(&__q, __end, &__out->f_zip.v)) return false;
                __out->f_zip.has = true;
            }
            __seen |= UINT64_C(1) << 1;
        } else {
            if (!json_skip_value(&__q, __end, __depth)) return false;
        }
        __q = json_skip_ws(__q, __end);
        if (__q >= __end) return false;
        if (*__q == ',') { __q++; continue; }
        if (*__q == '}') { __q++; break; }
        return false;
    }
    __done: ;
    *__p = __q;
    return (__seen & UINT64_C(0x1)) == UINT64_C(0x1);
}

static void tlj_write_Address(tlang_fiber* __fib, tlang_buf* __b, tl_Address* __v) {
    TLANG_BUF_PUT_LIT(__b, "{\"city\":");
    json_write_str(__b, __v->f_city);
    TLANG_BUF_PUT_LIT(__b, ",\"zip\":");
    if (__v->f_zip.has) {
        json_write_i32(__b, __v->f_zip.v);
    } else {
        json_write_null(__b);
    }
    tlang_buf_putc(__b, '}');
}

