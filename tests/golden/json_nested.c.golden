    tl_Address* f_work;
    tlang_slice_Tag* f_tags;
    tlang_slice_str* f_labels;
    tlang_slice_arr_i64* f_matrix;
    tlang_slice_opt_Tag* f_maybeTags;
    tlang_slice_opt_str* f_notes;
    int32_t f_small;
};

