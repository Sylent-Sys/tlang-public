int64_t tl_f_calls(tlang_fiber* __fib, tl_User* l_u, int64_t l_n) {
    int64_t l_a;
    int64_t l_b;
    int64_t l_c;
    int64_t __t1 = tl_m_User__plus(__fib, l_u, l_n);
    if (__fib->err) goto __fail;
    l_a = __t1;
    tl_User* __t2 = tl_f_mk(__fib, l_u);
    if (__fib->err) goto __fail;
    int64_t __t3 = tl_f_div(__fib, l_n, 2);
    if (__fib->err) goto __fail;
    int64_t __t4 = tl_m_User__plus(__fib, __t2, __t3);
