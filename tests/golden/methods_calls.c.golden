    l_b = __t4;
    int64_t __t5 = tl_f_div(__fib, l_n, 3);
    if (__fib->err) goto __fail;
    int64_t __t6 = tl_m_User__plus(__fib, l_u, __t5);
    if (__fib->err) goto __fail;
    l_c = __t6;
    return tlang_add_i64(tlang_add_i64(l_a, l_b), l_c);
    __fail: ;
