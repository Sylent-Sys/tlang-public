}

void tl_m_Context__risky(tlang_fiber* __fib, tlang_ctx* l_ctx) {
    if (!tl_f_allow(__fib, l_ctx)) goto __guard_denied;
    tlang_throw(__fib, 500, TLANG_STR("nope"));
    goto __fail;
    __fail: ;
    goto __after;
    __guard_denied: ;
    if (!l_ctx->response_sent) tlang_ctx_text(__fib, l_ctx, 403, TLANG_STR("Forbidden"));
    goto __after;
    __after: ;
    {
        int __after_err = __fib->err;
        tlang_error __after_e = __fib->error;
        tl_f_metric(__fib, l_ctx);
        if (__fib->err) tlang_console_error(__fib, (tlang_value[1]){ TLANG_VAL_STR(__fib->error.message) }, 1);
        __fib->err = __after_err;
        __fib->error = __after_e;
    }
    return;
}

void tl_f_route_dispatcher(tlang_fiber* __fib, tlang_ctx* l_ctx) {
    int64_t l_n;
    tl_m_Context__handle(__fib, l_ctx);
    if (__fib->err) goto __fail;
    int64_t __t1 = tl_f_tally(__fib, l_ctx, 5);
    if (__fib->err) goto __fail;
    l_n = __t1;
    (void)l_n;
    tl_m_Context__split(__fib, l_ctx);
    if (__fib->err) goto __fail;
    tl_m_Context__risky(__fib, l_ctx);
    if (__fib->err) goto __fail;
    return;
    __fail: ;
    return;
}

