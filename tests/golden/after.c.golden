bool tl_f_allow(tlang_fiber* __fib, tlang_ctx* l_ctx) {
    return true;
}

void tl_f_metric(tlang_fiber* __fib, tlang_ctx* l_ctx) {
    tlang_console_log(__fib, (tlang_value[1]){ TLANG_VAL_STR(TLANG_STR("done")) }, 1);
}

void tl_f_audit(tlang_fiber* __fib, tlang_ctx* l_ctx) {
    tlang_throw(__fib, 500, TLANG_STR("boom"));
    goto __fail;
    __fail: ;
    return;
}

void tl_m_Context__handle(tlang_fiber* __fib, tlang_ctx* l_ctx) {
    if (!tl_f_allow(__fib, l_ctx)) goto __guard_denied;
    tlang_ctx_text(__fib, l_ctx, 200, TLANG_STR("ok"));
    goto __after;
    __guard_denied: ;
    if (!l_ctx->response_sent) tlang_ctx_text(__fib, l_ctx, 403, TLANG_STR("Forbidden"));
    goto __after;
    __after: ;
    {
        int __after_err = __fib->err;
        tlang_error __after_e = __fib->error;
        tl_f_audit(__fib, l_ctx);
        if (__fib->err) tlang_console_error(__fib, (tlang_value[1]){ TLANG_VAL_STR(__fib->error.message) }, 1);
        __fib->err = __after_err;
        __fib->error = __after_e;
    }
    {
        int __after_err = __fib->err;
        tlang_error __after_e = __fib->error;
        tl_f_metric(__fib, l_ctx);
        if (__fib->err) tlang_console_error(__fib, (tlang_value[1]){ TLANG_VAL_STR(__fib->error.message) }, 1);
        __fib->err = __after_err;
        __fib->error = __after_e;
    }
    return;
}

int64_t tl_f_tally(tlang_fiber* __fib, tlang_ctx* l_c, int64_t l_base) {
    int64_t __after_ret = 0;
    __after_ret = tlang_add_i64(l_base, 1);
    goto __after;
    __after: ;
    {
        int __after_err = __fib->err;
        tlang_error __after_e = __fib->error;
        tl_f_metric(__fib, l_c);
        if (__fib->err) tlang_console_error(__fib, (tlang_value[1]){ TLANG_VAL_STR(__fib->error.message) }, 1);
        __fib->err = __after_err;
        __fib->error = __after_e;
    }
    return __after_ret;
}

void tl_m_Context__split(tlang_fiber* __fib, tlang_ctx* l_ctx) {
    goto __after;
    __after: ;
    {
        int __after_err = __fib->err;
        tlang_error __after_e = __fib->error;
        tl_f_audit(__fib, l_ctx);
        if (__fib->err) tlang_console_error(__fib, (tlang_value[1]){ TLANG_VAL_STR(__fib->error.message) }, 1);
        __fib->err = __after_err;
        __fib->error = __after_e;
    }
    {
        int __after_err = __fib->err;
        tlang_error __after_e = __fib->error;
        tl_f_metric(__fib, l_ctx);
        if (__fib->err) tlang_console_error(__fib, (tlang_value[1]){ TLANG_VAL_STR(__fib->error.message) }, 1);
        __fib->err = __after_err;
        __fib->error = __after_e;
