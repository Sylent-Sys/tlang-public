    (void)l_forcedXs;
    l_ra = l_a.has ? l_a.v : 0;
    l_rb = l_b.has ? l_b.v : 7;
    l_rc = l_c.has ? l_c.v : 1.5;
    (void)l_rc;
    l_rdd = l_d.has ? l_d.v : false;
