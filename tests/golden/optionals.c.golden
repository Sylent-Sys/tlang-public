void tl_f_widenArgs(tlang_fiber* __fib, int64_t l_n, tlang_string l_s, tl_User* l_u) {
    tl_f_takeOpt(__fib, TLANG_SOME(i64, l_n), tlang_str_some(l_s), l_u);
    if (__fib->err) goto __fail;
