}

tlang_string tl_f_twice__str(tlang_fiber* __fib, tlang_string l_x) {
    tlang_string l_y;
    tlang_string __t1 = tl_f_id__str(__fib, l_x);
    if (__fib->err) goto __fail;
    l_y = __t1;
    tlang_string __t2 = tl_f_id__str(__fib, l_y);
    if (__fib->err) goto __fail;
    return __t2;
    __fail: ;
