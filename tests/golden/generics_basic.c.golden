}

int64_t tl_f_twice__i64(tlang_fiber* __fib, int64_t l_x) {
    int64_t l_y;
    int64_t __t1 = tl_f_id__i64(__fib, l_x);
    if (__fib->err) goto __fail;
    l_y = __t1;
    int64_t __t2 = tl_f_id__i64(__fib, l_y);
    if (__fib->err) goto __fail;
    return __t2;
    __fail: ;
