    if (__fib->err) goto __fail;
    l_a = __t1;
    (void)l_a;
    tlang_string __t2 = tl_f_twice__str(__fib, TLANG_STR("s"));
    if (__fib->err) goto __fail;
    l_b = __t2;
    (void)l_b;
    double __t3 = tl_f_id__f64(__fib, 2.5);
    if (__fib->err) goto __fail;
    l_c = __t3;
    (void)l_c;
    bool __t4 = tl_f_swap__i32__bool(__fib, 1, true);
    if (__fib->err) goto __fail;
    l_d = __t4;
    (void)l_d;
