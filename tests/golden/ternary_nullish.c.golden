#include "tlang.h"

#if defined(__clang__)
#pragma clang diagnostic ignored "-Wself-assign"
#pragma clang diagnostic ignored "-Wtautological-compare"
#elif defined(__GNUC__)
#pragma GCC diagnostic ignored "-Wtautological-compare"
#endif

int64_t tl_f_div(tlang_fiber* __fib, int64_t l_a, int64_t l_b);
int64_t tl_f_tern(tlang_fiber* __fib, bool l_c, int64_t l_a, int64_t l_b, tlang_opt_i64 l_o);

int64_t tl_f_div(tlang_fiber* __fib, int64_t l_a, int64_t l_b) {
    int64_t __t1 = tlang_div_i64(__fib, l_a, l_b);
    if (__fib->err) goto __fail;
    return __t1;
    __fail: ;
    return 0;
}

int64_t tl_f_tern(tlang_fiber* __fib, bool l_c, int64_t l_a, int64_t l_b, tlang_opt_i64 l_o) {
    int64_t l_x;
    int64_t l_y;
    tlang_opt_i64 l_z;
    int64_t l_w;
    int64_t l_v;
    tlang_string l_s;
    tlang_opt_i64 l_t;
    l_x = l_c ? l_a : l_b;
    int64_t __t1;
    if (l_c) {
        int64_t __t2 = tl_f_div(__fib, l_a, l_b);
        if (__fib->err) goto __fail;
        __t1 = __t2;
    } else {
        __t1 = 0;
    }
    l_y = __t1;
    l_z = l_c ? TLANG_SOME(i64, l_a) : TLANG_NONE(i64);
    (void)l_z;
    int64_t __t3;
    if (l_o.has) {
        __t3 = l_o.v;
    } else {
        int64_t __t4 = tl_f_div(__fib, l_a, l_b);
        if (__fib->err) goto __fail;
        __t3 = __t4;
    }
    l_w = __t3;
    l_v = l_c ? ((l_a > l_b) ? l_a : l_b) : -1;
    l_s = l_c ? TLANG_STR("yes") : TLANG_STR("no");
    (void)l_s;
    l_t = l_c ? l_o : TLANG_SOME(i64, l_a);
    (void)l_t;
    return tlang_add_i64(tlang_add_i64(tlang_add_i64(l_x, l_y), l_w), l_v);
    __fail: ;
    return 0;
}

static const tlang_program __tl_program = {
    .init_globals = NULL,
    .globals_size = 0,
    .dispatcher   = NULL,
    .main         = NULL,
    .uses_db      = false,
};
int main(int argc, char** argv) { return tlang_main(argc, argv, &__tl_program); }
