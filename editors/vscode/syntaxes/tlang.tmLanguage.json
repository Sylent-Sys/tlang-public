{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TLang",
  "scopeName": "source.tlang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#decorators" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#declarations" },
    { "include": "#types" },
    { "include": "#namespaces" },
    { "include": "#numbers" },
    { "include": "#strings" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.tlang",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.tlang" }
          }
        },
        {
          "name": "comment.block.tlang",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.tlang" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.tlang" }
          }
        }
      ]
    },
    "decorators": {
      "name": "meta.decorator.tlang",
      "match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "punctuation.definition.decorator.tlang" },
        "2": { "name": "entity.name.function.decorator.tlang" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "match": "(\\*)\\s*\\b(as)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "constant.language.import-export-all.tlang" },
            "2": { "name": "keyword.control.as.tlang" },
            "3": { "name": "variable.other.readwrite.alias.tlang" }
          }
        },
        {
          "name": "keyword.control.import.tlang",
          "match": "\\bimport\\b"
        },
        {
          "name": "keyword.control.export.tlang",
          "match": "\\bexport\\b"
        },
        {
          "name": "keyword.control.from.tlang",
          "match": "\\bfrom\\b"
        },
        {
          "name": "keyword.control.as.tlang",
          "match": "\\bas\\b"
        },
        {
          "name": "keyword.control.default.tlang",
          "match": "\\bdefault\\b"
        },
        {
          "name": "keyword.control.tlang",
          "match": "\\b(if|else|for|while|break|continue|return|try|catch|throw|of)\\b"
        },
        {
          "name": "keyword.operator.new.tlang",
          "match": "\\bnew\\b"
        },
        {
          "name": "storage.modifier.tlang",
          "match": "\\bglobal\\b"
        }
      ]
    },
    "constants": {
      "name": "constant.language.tlang",
      "match": "\\b(true|false|null)\\b"
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(interface|type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.tlang" },
            "2": { "name": "entity.name.type.tlang" }
          }
        },
        {
          "name": "storage.type.tlang",
          "match": "\\b(let|const|fn|interface|type)\\b"
        }
      ]
    },
    "types": {
      "name": "support.type.tlang",
      "match": "\\b(int32|int64|float64|bool|string|void|Context|Error)\\b"
    },
    "namespaces": {
      "name": "support.class.tlang",
      "match": "\\b(db|console)\\b"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.tlang",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?\\b"
        },
        {
          "name": "constant.numeric.float.tlang",
          "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.hex.tlang",
          "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.tlang",
          "match": "\\b(0|[1-9][0-9_]*)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tlang",
          "begin": "\"",
          "end": "\"|(?=$)",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.tlang" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.tlang" }
          },
          "patterns": [{ "include": "#string-escapes" }]
        },
        {
          "name": "string.quoted.single.tlang",
          "begin": "'",
          "end": "'|(?=$)",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.tlang" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.tlang" }
          },
          "patterns": [{ "include": "#string-escapes" }]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.tlang",
          "match": "\\\\(u\\{[0-9a-fA-F]+\\}|u[0-9a-fA-F]{4}|[ntr0\\\\\"'])"
        },
        {
          "name": "invalid.illegal.unknown-escape.tlang",
          "match": "\\\\."
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(fn)\\s*\\(([^)]*)\\)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.tlang" },
            "2": { "patterns": [{ "include": "#parameters" }] },
            "3": { "name": "entity.name.function.tlang" }
          }
        },
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.tlang" },
            "2": { "name": "entity.name.function.tlang" }
          }
        },
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.tlang" }
          }
        }
      ]
    },
    "parameters": {
      "patterns": [
        { "include": "#types" },
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(?=:)",
          "captures": {
            "1": { "name": "variable.parameter.tlang" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.tlang",
          "match": "=>|==|!=|<=|>=|&&|\\|\\||\\?\\?|\\+=|-=|\\*=|/=|%=|\\+\\+|--|[=+\\-*/%!@|?<>]"
        },
        {
          "name": "punctuation.accessor.tlang",
          "match": "\\."
        }
      ]
    }
  }
}
